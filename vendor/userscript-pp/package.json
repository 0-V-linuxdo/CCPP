{
  "name": "userscript-pp",
  "version": "0.1.0",
  "description": "用户脚本开发框架:核心、构建工具、脚手架和补丁检查器",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0-V-linuxdo/UserscriptPP.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "uspp-build": "scripts/build.mjs",
    "uspp-create": "scripts/create.mjs",
    "uspp-check-patches": "scripts/check-patches.mjs"
  },
  "files": [
    "core",
    "plugins",
    "scripts",
    "types",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch --dev",
    "hot": "node scripts/build.mjs --hot",
    "create": "node scripts/create.mjs",
    "check:patches": "node scripts/check-patches.mjs",
    "test": "node --test test/smoke.test.mjs"
  },
  "dependencies": {
    "esbuild": "0.25.10",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "types": "types/index.d.ts"
}
