{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@kernel/*": ["src/kernel/*"],
      "@lib/*": ["src/lib/*"],
      "@api/*": ["src/plugins/_api/*"],
      "@core/*": ["src/plugins/_core/*"],
      "@plugins/*": ["src/plugins/*"]
    }
  },
  "include": ["src", "tests", "build.ts"]
}
